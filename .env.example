DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
SECRET_KEY=change-me-to-a-long-random-string
STORAGE_DIR=./storage

# ==============================================================================
# LLM Configuration
# ==============================================================================

# Global LLM provider: mock | gemini | openai (default: mock)
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.7

# Google Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Thinking level for reasoning models: minimal | low | medium | high
GEMINI_THINKING_LEVEL=minimal

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Reasoning effort for o-series models (optional: low | medium | high)
# OPENAI_REASONING_EFFORT=low

# Optional per-task overrides (override provider and/or model for specific pipeline tasks)
# Allowed tasks: script, storyboard, metadata, factcheck
# LLM_PROVIDER_SCRIPT=openai
# LLM_MODEL_SCRIPT=gpt-4o
# LLM_PROVIDER_STORYBOARD=gemini
# LLM_MODEL_STORYBOARD=gemini-2.5-flash
# LLM_PROVIDER_METADATA=openai
# LLM_MODEL_METADATA=gpt-4o-mini
# LLM_PROVIDER_FACTCHECK=gemini
# LLM_MODEL_FACTCHECK=gemini-2.5-flash
