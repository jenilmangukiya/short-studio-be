DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
SECRET_KEY=change-me-to-a-long-random-string
STORAGE_DIR=./storage

# ==============================================================================
# LLM Configuration
# ==============================================================================

# Global LLM provider: mock | gemini | openai (default: mock)
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=4096
# Temperature affects Gemini only; OpenAI provider omits temperature
LLM_TEMPERATURE=0.7

# Google Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Thinking level for reasoning models: minimal | low | medium | high
GEMINI_THINKING_LEVEL=minimal

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for OpenAI reasoning models.
# For gpt-6-luna, supported values are: none, low, medium, high, xhigh ("minimal" is rejected by API).
# Recommended starting value: low
OPENAI_REASONING_EFFORT=low

# Optional per-task overrides (override provider and/or model for specific pipeline tasks)
# Allowed tasks: script, storyboard, metadata, factcheck
# LLM_PROVIDER_SCRIPT=openai
# LLM_MODEL_SCRIPT=gpt-4o
# LLM_PROVIDER_STORYBOARD=gemini
# LLM_MODEL_STORYBOARD=gemini-2.5-flash
# LLM_PROVIDER_METADATA=openai
# LLM_MODEL_METADATA=gpt-4o-mini
# LLM_PROVIDER_FACTCHECK=gemini
# LLM_MODEL_FACTCHECK=gemini-2.5-flash

# ==============================================================================
# Image Generation Configuration
# ==============================================================================

# Image provider: mock | openai (default: mock)
IMAGE_PROVIDER=mock

# OpenAI image generation settings
# Note: OPENAI_IMAGE_API_KEY is isolated and never falls back to OPENAI_API_KEY.
OPENAI_IMAGE_API_KEY=

# Model name: must be copied directly from your OpenAI dashboard project's model list.
# No default model is configured in code.
OPENAI_IMAGE_MODEL=

# Preset portrait size is 1024x1536 (2:3 aspect ratio).
# Arbitrary resolutions must have width & height divisible by 16 (note: 1080 is not divisible by 16;
# 864x1536 is a valid exact 9:16 option to try once).
OPENAI_IMAGE_SIZE=1024x1536

# Quality: low | medium | high | xhigh | max (default: low)
OPENAI_IMAGE_QUALITY=low

# Optional per-image cost estimate in USD (e.g. 0.04). Unset/null by default.
# Never hard-coded in code.
OPENAI_IMAGE_EST_COST_USD=

# Pipeline safety limits
IMAGE_MAX_PER_VIDEO=12
IMAGE_TIMEOUT_SECONDS=120.0

